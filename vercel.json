{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*).css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/login",
      "destination": "https://app.seros.dev/login",
      "permanent": false
    },
    {
      "source": "/signup",
      "destination": "https://app.seros.dev/signup",
      "permanent": false
    },
    {
      "source": "/queue",
      "destination": "https://app.seros.dev/queue",
      "permanent": false
    },
    {
      "source": "/tasks",
      "destination": "https://app.seros.dev/tasks",
      "permanent": false
    },
    {
      "source": "/ask",
      "destination": "https://app.seros.dev/ask",
      "permanent": false
    },
    {
      "source": "/digest",
      "destination": "https://app.seros.dev/digest",
      "permanent": false
    },
    {
      "source": "/connect",
      "destination": "https://app.seros.dev/connect",
      "permanent": false
    },
    {
      "source": "/connect/(.*)",
      "destination": "https://app.seros.dev/connect/$1",
      "permanent": false
    },
    {
      "source": "/channels",
      "destination": "https://app.seros.dev/channels",
      "permanent": false
    },
    {
      "source": "/members",
      "destination": "https://app.seros.dev/members",
      "permanent": false
    },
    {
      "source": "/members/(.*)",
      "destination": "https://app.seros.dev/members/$1",
      "permanent": false
    },
    {
      "source": "/audit",
      "destination": "https://app.seros.dev/audit",
      "permanent": false
    },
    {
      "source": "/auth/(.*)",
      "destination": "https://app.seros.dev/auth/$1",
      "permanent": false
    },
    {
      "source": "/oauth/(.*)",
      "destination": "https://app.seros.dev/oauth/$1",
      "permanent": false
    },
    {
      "source": "/confirm",
      "destination": "https://app.seros.dev/confirm",
      "permanent": false
    },
    {
      "source": "/logout",
      "destination": "https://app.seros.dev/logout",
      "permanent": false
    },
    {
      "source": "/password",
      "destination": "https://app.seros.dev/password",
      "permanent": false
    },
    {
      "source": "/set-password",
      "destination": "https://app.seros.dev/set-password",
      "permanent": false
    }
  ]
}
