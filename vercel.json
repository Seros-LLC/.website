{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/login", "destination": "https://app.seros.dev/login" },
    { "source": "/demo", "destination": "https://app.seros.dev/demo" },
    { "source": "/queue", "destination": "https://app.seros.dev/queue" },
    { "source": "/tasks", "destination": "https://app.seros.dev/tasks" },
    { "source": "/ask", "destination": "https://app.seros.dev/ask" },
    { "source": "/digest", "destination": "https://app.seros.dev/digest" },
    { "source": "/connect", "destination": "https://app.seros.dev/connect" },
    { "source": "/connect/(.*)", "destination": "https://app.seros.dev/connect/$1" },
    { "source": "/channels", "destination": "https://app.seros.dev/channels" },
    { "source": "/members", "destination": "https://app.seros.dev/members" },
    { "source": "/members/(.*)", "destination": "https://app.seros.dev/members/$1" },
    { "source": "/audit", "destination": "https://app.seros.dev/audit" },
    { "source": "/auth/(.*)", "destination": "https://app.seros.dev/auth/$1" },
    { "source": "/oauth/(.*)", "destination": "https://app.seros.dev/oauth/$1" },
    { "source": "/confirm", "destination": "https://app.seros.dev/confirm" },
    { "source": "/logout", "destination": "https://app.seros.dev/logout" },
    { "source": "/password", "destination": "https://app.seros.dev/password" },
    { "source": "/set-password", "destination": "https://app.seros.dev/set-password" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*).css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
